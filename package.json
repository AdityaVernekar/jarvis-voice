{
  "name": "jarvis-voice",
  "version": "0.2.2",
  "description": "A voice hub for terminal coding agents. Claude Code, Codex CLI and any other agent tell you out loud when they finish or need you.",
  "type": "module",
  "bin": {
    "jarvis": "./bin/jarvis.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "jarvis.mjs",
    "install.mjs",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node -e \"for (const f of require('fs').readdirSync('.',{recursive:true})) if (/\\.mjs$/.test(f) && !f.includes('node_modules')) require('child_process').execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "install-hooks": "node bin/jarvis.mjs install",
    "uninstall-hooks": "node bin/jarvis.mjs uninstall"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "codex",
    "coding-agents",
    "ai-agents",
    "multi-agent",
    "text-to-speech",
    "tts",
    "notifications",
    "cli",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdityaVernekar/jarvis-voice.git"
  },
  "bugs": {
    "url": "https://github.com/AdityaVernekar/jarvis-voice/issues"
  },
  "homepage": "https://github.com/AdityaVernekar/jarvis-voice#readme",
  "author": "Aditya Vernekar",
  "license": "MIT"
}
